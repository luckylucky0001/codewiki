 "claims": [
  {
   "id": "C1",
   "text": "WMFData is a local Swift package designed to house all of the logic pertaining to the data layer",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Package.swift"
  },
  {
   "id": "C2",
   "text": "Services: Sources > WMFData > Services",
   "source": "CLAUDE.md",
   "label": "conflict",
   "evidence": "WMFData/Sources/WMFData/Service (singular)",
   "note": "minor path drift"
  },
  {
   "id": "C3",
   "text": "We have two services: WMFBasicService and mediaWikiService",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Service/WMFBasicService.swift; Environment mediaWikiService"
  },
  {
   "id": "C4",
   "text": "Currently we have 3 stores: userDefaultsStore, sharedCacheStore, coreDataStore",
   "source": "CLAUDE.md",
   "label": "conflict",
   "evidence": "WMFData/Sources/WMFData/Environment (4 stores: + crossProcessUserDefaultsStore)"
  },
  {
   "id": "C5",
   "text": "userDefaultsStore and sharedCacheStore are accessed via a generalized protocol WMFKeyValueStore",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Store/Protocol/WMFKeyValueStore.swift"
  },
  {
   "id": "C6",
   "text": "coreDataStore - capable of saving and loading to WMFData's own Core Data xcdatamodel",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Resources/WMFData.xcdatamodeld"
  },
  {
   "id": "C7",
   "text": "WMFImageDataController.shared - use this singleton to fetch image data in WMFComponents",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Data Controllers/Shared/WMFImageDataController.swift:4"
  },
  {
   "id": "C8",
   "text": "Data Controllers live in Sources > WMFData > Data Controllers",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Data Controllers"
  },
  {
   "id": "C9",
   "text": "Stores can be accessed via the WMFDataEnvironment.current singleton",
   "source": "CLAUDE.md",
   "label": "verified",
   "evidence": "WMFData/Sources/WMFData/Environment"
  },
  {
   "id": "C10",
   "text": "Stores and services should be strictly feature-agnostic",
   "source": "CLAUDE.md",
   "label": "unverifiable",
   "evidence": "(design guideline)"
  }
 ],
 "notes": "Mixed ObjC/Swift UIKit. Router.Destination enum maps URLs to destinations, ViewControllerRouter instantiates VCs. wikipedia:// hosts parsed in ObjC (NSUserActivity+WMFExtensions.m). accessibilityIdentifiers are centralised constants (values are human strings like \"Article View\"); label file = declaration, alt_files = assignment site. APIs built from base path constants + additionalPathComponents arrays (hard). Clone reused read-only from oss2."
}